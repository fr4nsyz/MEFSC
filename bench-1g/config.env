# bench-1g Configuration
# Network
BRIDGE_NAME=bridge1
SERVER_IP=10.0.0.1
CLIENT_IP=10.0.0.2
SUBNET=10.0.0.0/24

# dummynet pipe 1
# NOTE: macOS dnctl supports only K/M units (no G) and delay rounds to 10ms tick,
# so sub-ms LAN latency can't be simulated; delay is omitted for clean throughput.
PIPE_NUM=1
BANDWIDTH=1000Mbit/s
QUEUE_SLOTS=100
PLR=0.0

# iperf3
PARALLEL_STREAMS=4
DURATION_SEC=30
TCP_WINDOW=1M
BIND_SERVER=true
REPORT_INTERVAL=1

# Docker
IPERF3_IMAGE=ghcr.io/networkstatic/iperf3:latest
USE_DOCKER=true